{
  "manifest_version": 3,
  "name": "HistoryOut - Find & Export History",
  "short_name": "HistoryOut",
  "version": "2.0.0",
  "description": "Revisit your day. Find and filter browser history, then export what matters to CSV, JSON or HTML. Free and local.",
  "permissions": ["history", "storage", "sidePanel"],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "side-panel.html"
  },
  "action": {
    "default_title": "Click to open HistoryOut",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "minimum_chrome_version": "114.0.0"
}
