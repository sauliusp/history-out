{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "short_name": "HistoryOut",
  "version": "2.2.0",
  "description": "__MSG_extensionDescription__",
  "permissions": [
    "history",
    "storage",
    "sidePanel"
  ],
  "background": {
    "service_worker": "background.js"
